{
  "task": "disease_classification",
  "seed": 42,
  "datasets": {
    "plantvillage": {
      "manifests_dir": "data/splits/plantvillage",
      "role": "primary"
    },
    "plantdoc": {
      "manifests_dir": "data/splits/plantdoc",
      "role": "domain_adaptation_and_external_eval"
    }
  },
  "label_strategy": "plantvillage_primary_with_plantdoc_mapped",
  "output_dir": "models/disease",
  "runs_dir": "models/disease/runs",
  "preprocessing": {
    "image_size": 224,
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "augmentation": {
    "train": {
      "horizontal_flip": true,
      "rotation_degrees": 15,
      "color_jitter": {
        "brightness": 0.2,
        "contrast": 0.2,
        "saturation": 0.1
      }
    },
    "val_test": {
      "resize_only": true
    }
  },
  "training": {
    "architectures": [
      "mobilenet_v3_small",
      "efficientnet_b0"
    ],
    "epochs": 3,
    "batch_size": 16,
    "num_workers": 0,
    "optimizer": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "scheduler": "cosine",
    "early_stopping_patience": 3,
    "class_weighting": true,
    "pretrained": true,
    "mixed_precision": false
  },
  "evaluation": {
    "metrics": [
      "accuracy",
      "precision_macro",
      "recall_macro",
      "f1_macro",
      "precision_weighted",
      "recall_weighted",
      "f1_weighted"
    ],
    "save_confusion_matrix": true,
    "save_per_class": true,
    "latency_batch_size": 1,
    "latency_warmup": 10,
    "latency_runs": 50
  },
  "export": {
    "onnx": true,
    "opset": 17
  }
}