# AgriEdge Rover Environment Variables

# Application modes
MOCK_MODE=true
DEMO_MODE=true
CLOUD_SYNC_ENABLED=false

# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/agriedge.db

# ESP32 serial (placeholder)
ESP32_SERIAL_PORT=COM3
ESP32_BAUD_RATE=115200

# Paths
MODELS_DIR=./models
IMAGES_DIR=./data/own/images
CONFIG_DIR=./config

# Frontend (for reference — set in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_USE_MOCK=false

# Logging
LOG_LEVEL=INFO
